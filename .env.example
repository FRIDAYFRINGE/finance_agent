# LLM Provider Configuration (OpenRouter)
# Required: Provide your OpenRouter API key to run live queries
OPENAI_API_KEY=your_openrouter_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Recommended Model Options:
# 1. z-ai/glm-5.3-flash (Default: high-speed, cost-effective, passes 100% of benchmark tests)
# 2. deepseek/deepseek-v4-pro-0813 (Alternative: deep reasoning model)
OPENAI_MODEL=z-ai/glm-5.3-flash
